    "# Delta, Gamma and Vega as functions of spot -- classic shapes as sanity checks\n",
    "spots = np.linspace(50, 150, 200)\n",
    "deltas = [bs_greeks(s, K, r, sigma, tau, \"call\")[\"delta\"] for s in spots]\n",
    "gammas = [bs_greeks(s, K, r, sigma, tau, \"call\")[\"gamma\"] for s in spots]\n",
    "vegas  = [bs_greeks(s, K, r, sigma, tau, \"call\")[\"vega\"]  for s in spots]\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
    "for ax, y, title in zip(axes, [deltas, gammas, vegas], [\"Delta\", \"Gamma\", \"Vega\"]):\n",
    "    ax.plot(spots, y)\n",
    "    ax.axvline(K, color=\"grey\", linestyle=\"--\", linewidth=1, label=\"Strike K\")\n",
    "    ax.set_title(f\"Call {title} vs Spot\")\n",
    "    ax.set_xlabel(\"S\")\n",
    "    ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
